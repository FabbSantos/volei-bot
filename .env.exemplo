# Copie para .env na VPS e preencha. O .env NÃO vai pro git.
# Os valores atuais de produção saem de `railway variables` enquanto o
# Railway estiver de pé — depois disso, só existem aqui.

# Seu número, pra usar comandos de admin no privado do bot (formato 55DDNNNNNNNNN@c.us)
ADMIN_NUMBER=

# Senha do painel web. Qualquer string longa e aleatória serve; é ela que
# protege /painel, /api e /backup.
PAINEL_TOKEN=

# Senha única do painel (sem usuário) — a que os admins digitam pra entrar.
# Sem ela, só dá pra entrar pelo link com ?token=
PAINEL_SENHA=

# Hora do recado diário de cobrança, em Brasília (0-23). Só dispara com lista aberta.
# off (ou 0) desliga o recado automático — a cobrança passa a ser só sob
# demanda, com #cobrarde. Sem a variável, vale o padrão de 10h.
LEMBRETE_HORA=off

# Nome da máquina no #teste. Sem isso aparece o ID do container do Docker,
# que muda a cada build e não diz onde o bot está rodando.
HOST_APELIDO=

# --- opcionais ---

# Avisa no Telegram quando a reconexão falha várias vezes seguidas.
# Sem os dois preenchidos, o bot só registra no log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Limita o bot a um grupo específico pelo nome. Vazio = atende todos os grupos ativos.
NOME_GRUPO_ALVO=

# Figurinha fixa pro tema "agiota pago" (ignora o sorteio). Ex: assets/agiota-pago-11.webp
FIGURINHA_QUITADO=

# Apaga o perfil do Chrome no próximo boot e pede QR novo. Use só pra sair de
# perfil corrompido — e DESLIGUE (0) assim que parear, senão todo restart
# derruba o pareamento.
RESET_SESSAO=0

# ---- Vídeo (só na máquina que tem a câmera; o bot da VPS não usa) ----------
# npm run gravar | npm run cortar -- "sexta 20h-21h" | npm run pedacos
# Fonte: teste (imagem sintética), webcam ou rtsp (câmera IP da quadra)
VIDEO_FONTE=teste
# webcam: nome do dispositivo (Windows) ou /dev/video0 (Linux). Pra ver os
# nomes no Windows: ffmpeg -list_devices true -f dshow -i dummy
VIDEO_DISPOSITIVO=Integrated Webcam
# rtsp: endereço da câmera IP
VIDEO_URL=
VIDEO_PASTA=gravacoes
# Duração de cada pedaço gravado, em segundos
VIDEO_SEGUNDOS=300
# Depois de quantos dias a gravação é apagada
VIDEO_RETENCAO_DIAS=7
VIDEO_MAX_MINUTOS=180
# Caminho do ffmpeg, se ele não estiver no PATH
FFMPEG_PATH=
